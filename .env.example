# --- Storage (optional; dashboard + hosted orders need it) ---
# Neon Postgres connection string. Without it the dashboard runs in-memory and
# hosted-audit orders cannot be recorded.
POSTGRES_URL=
# Local embedded Postgres (PGlite) directory — alternative to POSTGRES_URL for the local hub.
LAUNCHAUDIT_LOCAL_DB=
# Vercel Blob token for artifact uploads (optional).
BLOB_READ_WRITE_TOKEN=
# Shared secret to sign runner writes to /api/runner/sync (optional hardening).
RUNNER_SYNC_SECRET=

# --- Hosted deep audit orders (Stripe Checkout) ---
# Secret key (sk_live_… / sk_test_…). Used by /api/checkout to create sessions.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint pointed at https://80-20.dev/api/stripe-webhook
# (event: checkout.session.completed).
STRIPE_WEBHOOK_SECRET=
# Stripe Price ids. If unset, /api/checkout falls back to inline price_data at the same amounts.
STRIPE_PRICE_AUDIT_SINGLE=price_...   # $79 Single Run (the only tier sold from the page)
STRIPE_PRICE_AUDIT=        # tier "standard" — $149
STRIPE_PRICE_AUDIT_PRO=    # tier "pro" — $499

# Optional: Google PageSpeed Insights key (any GCP API key with the PageSpeed API enabled).
# Adds Lighthouse + Core Web Vitals to paid Single Run grades; without it those rows are omitted.
PAGESPEED_API_KEY=

# Set to 0 to stop the automatic Stripe refund of a blocked Single Run (refund policy says it is automatic).
AUTO_REFUND_BLOCKED=1

# --- Weekly monitoring (optional) ---
# Protects /api/rescan-cron. When set, the cron caller must send Authorization:
# Bearer <CRON_SECRET> (Vercel Cron does automatically) or ?key=<CRON_SECRET>.
CRON_SECRET=
# Operator's OWN SMTP server for the weekly diff email (implicit TLS / port 465).
# No third-party mail vendor. When unset, the cron computes + stores the diff but
# sends no email (reported as "SMTP not configured").
MONITOR_SMTP_URL=      # smtps://user:pass@smtp.yourdomain.com:465
MONITOR_MAIL_FROM=     # alerts@yourdomain.com
