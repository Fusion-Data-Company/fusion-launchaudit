# --- Storage (optional; dashboard + hosted orders need it) ---
# Neon Postgres connection string. Without it the dashboard runs in-memory and
# hosted-audit orders cannot be recorded.
POSTGRES_URL=
# Local embedded Postgres (PGlite) directory — alternative to POSTGRES_URL for the local hub.
LAUNCHAUDIT_LOCAL_DB=
# Vercel Blob token for artifact uploads (optional).
BLOB_READ_WRITE_TOKEN=
# Shared secret to sign runner writes to /api/runner/sync (optional hardening).
RUNNER_SYNC_SECRET=

# --- Hosted deep audit orders (Stripe Checkout) ---
# Secret key (sk_live_… / sk_test_…). Used by /api/checkout to create sessions.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint pointed at https://80-20.dev/api/stripe-webhook
# (event: checkout.session.completed).
STRIPE_WEBHOOK_SECRET=
# Stripe Price ids. If unset, /api/checkout falls back to inline price_data at the same amounts.
STRIPE_PRICE_AUDIT=        # tier "standard" — $149
STRIPE_PRICE_AUDIT_PRO=    # tier "pro" — $499
